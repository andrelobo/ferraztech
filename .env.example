# ──────────────────────────────────────
# FERRAZTECH — Environment Variables
# ──────────────────────────────────────

# Node
NODE_ENV=development
PORT=3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ferraztech?retryWrites=true&w=majority

# WhatsApp
WHATSAPP_SESSION_PATH=./sessions
WHATSAPP_MAX_RETRIES=5
WHATSAPP_RETRY_DELAY_MS=5000

# Bull (fila de mensagens)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (futuro)
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Admin
ADMIN_EMAIL=admin@ferraztech.com
ADMIN_PASSWORD=change-me

# CORS
CORS_ORIGIN=http://localhost:5173
