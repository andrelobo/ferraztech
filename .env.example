# ──────────────────────────────────────
# FERRAZTECH — Environment Variables
# ──────────────────────────────────────

# Node
NODE_ENV=development
PORT=3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.smxzusu.mongodb.net/ferraztech?retryWrites=true&w=majority&appName=Cluster0

# WhatsApp
WHATSAPP_SESSION_PATH=./sessions
WHATSAPP_MAX_RETRIES=5
WHATSAPP_RETRY_DELAY_MS=5000
WHATSAPP_REAUTH_DELAY_MS=30000
WHATSAPP_SESSION_COUNT=1
WHATSAPP_AUTH_TIMEOUT_MS=60000
WHATSAPP_QR_MAX_RETRIES=0
WHATSAPP_TAKEOVER_ON_CONFLICT=true
WHATSAPP_TAKEOVER_TIMEOUT_MS=5000

# Bull (fila de mensagens)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Admin
ADMIN_EMAIL=admin@ferraztech.com
ADMIN_PASSWORD=change-me

# CORS
CORS_ORIGIN=http://localhost:5173
